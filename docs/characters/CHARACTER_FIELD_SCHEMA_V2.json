  "measurementProtocol": {
    "units": "cm for circumferences/lengths, degrees for rotation, dimensionless for ratios; use null when unknown",
    "faceNormalizedCoordinates": "facial landmarks use x=0 left, x=1 right, y=0 top of head, y=1 chin, defined in the SAME approved front-view portrait reference; 0-1 values must never be fabricated",
    "measurementStatuses": "user_confirmed / approved_art_reference / approved_story_reference / proposed / unknown / not_applicable / rejected",
    "crossView": "front, three-quarter, profile and back must share body proportions and face identity; perspective foreshortening is not a physical circumference change",
    "approval": "numerical details from proposals cannot overwrite approved artwork"
  },
