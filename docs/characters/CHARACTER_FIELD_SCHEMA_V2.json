    "user_confirmed",
    "approved_art_reference",
    "approved_story_reference",
    "proposed",
    "unknown",
    "not_applicable",
    "rejected"
  ],
  "valueExample": {
    "value": null,
    "status": "unknown",
    "source": null,
    "notes": null
  },
  "mandatorySections": [
    "identity",
    "family",
    "education",
    "measurements",
    "anatomy",
    "face",
    "hair",
    "wardrobe",
    "temperament",
    "psychology",
